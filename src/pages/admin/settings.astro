---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../lib/auth';
import { getGlobalSettings } from '../../lib/db';
import { getBindings } from '../../lib/runtime';

export const prerender = false;

const bindings = getBindings();
const session = await getSession(bindings.DB, Astro.request, bindings.SESSION_SECRET);
if (!session) return Astro.redirect('/login');
Astro.locals.csrfToken = session.csrfToken;

const settings = await getGlobalSettings(bindings.DB);
if (!settings) return new Response('Global settings are unavailable', { status: 500 });

const notificationsUpdated = Astro.url.searchParams.get('notifications_updated') === '1';
const credentialsUpdated = Astro.url.searchParams.get('credentials_updated') === '1';
const notificationError = Astro.url.searchParams.get('notification_error');
const credentialsError = Astro.url.searchParams.get('credentials_error');
---

<AdminLayout title="Global settings" description="Manage administrator notifications and sign-in credentials.">
	<a class="breadcrumb" href="/admin">← Dashboard</a>
	<div class="admin-title-row">
		<div>
			<span class="eyebrow">Global settings</span>
			<h1>Account and notifications.</h1>
			<p>These settings apply to every waiting list.</p>
		</div>
	</div>

	{notificationsUpdated && <div class="toast" role="status">Notification settings updated.</div>}
	{credentialsUpdated && <div class="toast" role="status">Sign-in settings updated.</div>}
	{notificationError === 'invalid' && <div class="form-error" role="alert">Enter a valid administrator email address.</div>}
	{credentialsError === 'invalid' && <div class="form-error" role="alert">Use a 2–50 character username and a new password of at least 12 characters.</div>}
	{credentialsError === 'mismatch' && <div class="form-error" role="alert">The new passwords do not match.</div>}
	{credentialsError === 'current' && <div class="form-error" role="alert">The current password is incorrect.</div>}

	<div class="global-settings-grid">
		<section class="panel settings-panel">
			<div class="panel-head"><h2>Join notifications</h2><span class="mono">ALL LISTS</span></div>
			<form class="settings-form" action="/admin/api/settings" method="post">
				<input type="hidden" name="csrf" value={session.csrfToken} />
				<input type="hidden" name="action" value="notifications" />
				<div class="field">
					<label for="admin-email">Administrator email</label>
					<input id="admin-email" type="email" name="admin_email" value={settings.admin_email} maxlength="254" autocomplete="email" required />
					<span class="hint">Confirmed signup notifications are sent to this address.</span>
				</div>
				<label class="toggle-field" for="notify-on-join">
					<input id="notify-on-join" type="checkbox" name="notify_on_join" checked={settings.notify_on_join === 1} />
					<span class="toggle-control" aria-hidden="true"></span>
					<span><strong>Email me after double opt-in</strong><small>Send one notification when a subscriber confirms their email for any waiting list.</small></span>
				</label>
				<div class="settings-actions">
					<button class="button button-dark" type="submit">Save notifications</button>
				</div>
			</form>
		</section>

		<section class="panel settings-panel">
			<div class="panel-head"><h2>Administrator sign-in</h2><span class="mono">SECURITY</span></div>
			<form class="settings-form" action="/admin/api/settings" method="post">
				<input type="hidden" name="csrf" value={session.csrfToken} />
				<input type="hidden" name="action" value="credentials" />
				<div class="field">
					<label for="admin-username">Username</label>
					<input id="admin-username" name="username" value={settings.admin_username} minlength="2" maxlength="50" pattern="[A-Za-z0-9._-]+" autocomplete="username" required />
				</div>
				<div class="field">
					<label for="current-password">Current password</label>
					<input id="current-password" type="password" name="current_password" maxlength="300" autocomplete="current-password" required />
					<span class="hint">Required to change your username or password.</span>
				</div>
				<div class="field">
					<label for="new-password">New password <span class="optional-label">Optional</span></label>
					<input id="new-password" type="password" name="new_password" minlength="12" maxlength="300" autocomplete="new-password" />
				</div>
				<div class="field">
					<label for="confirm-password">Confirm new password</label>
					<input id="confirm-password" type="password" name="confirm_password" minlength="12" maxlength="300" autocomplete="new-password" />
					<span class="hint">Leave both new-password fields empty to keep the current password. Changing credentials signs out every active session.</span>
				</div>
				<div class="settings-actions">
					<button class="button button-dark" type="submit">Update sign-in</button>
				</div>
			</form>
		</section>
	</div>
</AdminLayout>
